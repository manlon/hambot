<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%!-- video.twimg.com rejects requests carrying a third-party Referer. --%>
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{@status.author.name} (@{@status.author.handle}) on X</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f7f7f8;
        --card: #ffffff;
        --text: #0f1419;
        --muted: #536471;
        --border: #dcdfe3;
        --link: #1d5fbf;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1419;
          --card: #16202a;
          --text: #e7e9ea;
          --muted: #8b98a5;
          --border: #2f3b47;
          --link: #7fb2ff;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      main { max-width: 600px; margin: 0 auto; padding: 24px 12px 48px; }
      a { color: var(--link); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .tweet {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
      }
      .tweet.quoted { margin-top: 12px; padding: 12px; font-size: 15px; }
      .tweet header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
      .avatar { width: 44px; height: 44px; border-radius: 50%; }
      .quoted .avatar { width: 24px; height: 24px; }
      .who { display: flex; flex-direction: column; line-height: 1.25; }
      .quoted .who { flex-direction: row; gap: 6px; }
      .name { font-weight: 700; }
      .handle { color: var(--muted); }
      .text { margin: 0 0 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
      .media { margin: 12px 0; }
      .media img, .media video {
        display: block;
        max-width: 100%;
        height: auto;
        max-height: 80vh;
        border-radius: 12px;
        background: #000;
      }
      .photos { display: grid; gap: 6px; }
      .tweet footer { margin-top: 12px; color: var(--muted); font-size: 14px; }
      .tweet footer a { color: inherit; }
      .about { margin-top: 16px; color: var(--muted); font-size: 13px; text-align: center; }
    </style>
  </head>
  <body>
    <main>
      <.tweet status={@status} />
      <p class="about">
        Rendered by hambot from FxTwitter's public API. <a href={@status.url}>Open on x.com</a>
      </p>
    </main>
  </body>
</html>
